#!/bin/sh
# SimpleHome Browser AppImage entry point: the system's Python, GTK 3 and WebKitGTK 4.1 run the bundled app
HERE="$(dirname "$(readlink -f "$0")")"
if ! python3 -c 'import gi; gi.require_version("WebKit2", "4.1")' 2>/dev/null; then
  msg="SimpleHome Browser needs python-gobject and webkit2gtk-4.1:  sudo pacman -S python-gobject webkit2gtk-4.1"
  command -v notify-send >/dev/null && notify-send "SimpleHome Browser" "$msg"
  echo "$msg" >&2; exit 1
fi
exec python3 -I "$HERE/usr/share/simplehome-browser/browser.py" "$@"
